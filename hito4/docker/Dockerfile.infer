# =============================================================================
# Imagen de INFERENCIA de CARDIS
# -----------------------------------------------------------------------------
# Contenedor que arranca la API FastAPI, expone los endpoints
# del Open Inference Protocol y carga el modelo entrenado bien desde un
# volumen compartido, bien desde MinIO. 
# =============================================================================
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UVICORN_WORKERS=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/infer.txt /app/requirements/infer.txt
RUN pip install --upgrade pip \
    && pip install -r /app/requirements/infer.txt

COPY src /app/src

RUN useradd --create-home --shell /usr/sbin/nologin cardis \
    && mkdir -p /app/models /app/data \
    && chown -R cardis:cardis /app
USER cardis

ENV CARDIS_MODEL_DIR=/app/models \
    CARDIS_DATA_DIR=/app/data \
    CARDIS_LOG_LEVEL=INFO

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl --fail http://localhost:8080/v2/health/live || exit 1

CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
