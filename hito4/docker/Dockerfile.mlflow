# =============================================================================
# Servidor MLflow para tracking de experimentos.
# -----------------------------------------------------------------------------
# Almacena los runs en SQLite y delega los artefactos a MinIO via S3 API.
# =============================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip \
    && pip install "mlflow==2.16.2" "boto3==1.35.36" "psycopg2-binary==2.9.9"

EXPOSE 5000

ENV MLFLOW_BACKEND_STORE_URI="sqlite:////mlflow/mlflow.db" \
    MLFLOW_DEFAULT_ARTIFACT_ROOT="s3://cardis-mlflow/" \
    MLFLOW_S3_ENDPOINT_URL="http://minio:9000" \
    AWS_ACCESS_KEY_ID="minioadmin" \
    AWS_SECRET_ACCESS_KEY="minioadmin"

VOLUME ["/mlflow"]

CMD ["sh", "-c", "mlflow server --host 0.0.0.0 --port 5000 \
     --backend-store-uri ${MLFLOW_BACKEND_STORE_URI} \
     --default-artifact-root ${MLFLOW_DEFAULT_ARTIFACT_ROOT}"]
